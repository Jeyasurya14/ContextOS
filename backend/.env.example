# backend/.env.example

# Application
APP_NAME=ContextOS
APP_VERSION=0.1.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://contextos:contextos_dev_password@localhost:5432/contextos

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=context_chunks

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (AES-256-GCM for OAuth tokens)
ENCRYPTION_KEY=change-me-32-byte-key-for-aes256!

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_TEAM_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limits
RATE_LIMIT_FREE=50/day
RATE_LIMIT_PRO=1000/day
