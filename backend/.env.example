# backend/.env.example

# Application
APP_NAME=ContextOS
APP_VERSION=0.1.0
DEBUG=False
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Redis
REDIS_URL=redis://host:6379

# Qdrant
QDRANT_HOST=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_COLLECTION=context_chunks
QDRANT_API_KEY=your_qdrant_api_key_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (AES-256-GCM for OAuth tokens)
ENCRYPTION_KEY=your_encryption_key_here_use_openssl_rand_hex_32

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_REDIRECT_URI=https://your-domain.com/api/v1/integrations/github/callback

# Notion OAuth
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
NOTION_REDIRECT_URI=https://your-domain.com/api/v1/integrations/notion/callback

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=https://your-domain.com/api/v1/integrations/slack/callback

# OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Razorpay
RAZORPAY_KEY_ID=rzp_test_or_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret
RAZORPAY_PLAN_FREE=plan_free_id_here
RAZORPAY_PLAN_PRO=plan_pro_id_here
RAZORPAY_PLAN_TEAM=plan_team_id_here
RAZORPAY_CURRENCY=INR

# Frontend
FRONTEND_URL=https://contextos.learnmade.in
ENVIRONMENT=production
BACKEND_URL=https://contextos-api-jxdr.onrender.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://contextos.learnmade.in

# Rate limits
RATE_LIMIT_FREE=50/day
RATE_LIMIT_PRO=1000/day
