# backend/.env.example

# Application
APP_NAME=ContextOS
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# Database (use asyncpg for async, connection pool optimized)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=1800

# Redis (with password recommended for production)
REDIS_URL=redis://:password@host:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_CONNECT_TIMEOUT=10

# Qdrant (cloud or self-hosted)
QDRANT_HOST=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=context_chunks
QDRANT_USE_HTTPS=true

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-minimum-32-chars-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=change-me-32-bytes-in-production

# OpenAI (configure your API key)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_REDIRECT_URI=https://your-domain.com/api/v1/integrations/github/callback

# Notion OAuth
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
NOTION_REDIRECT_URI=https://your-domain.com/api/v1/integrations/notion/callback

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=https://your-domain.com/api/v1/integrations/slack/callback

# Linear OAuth
LINEAR_CLIENT_ID=your_linear_client_id
LINEAR_CLIENT_SECRET=your_linear_client_secret
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret
LINEAR_REDIRECT_URI=https://your-domain.com/api/v1/integrations/linear/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/integrations/google/callback

# Razorpay (optional - for billing)
RAZORPAY_KEY_ID=rzp_test_or_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret
RAZORPAY_PRO_PLAN_ID=plan_pro_id
RAZORPAY_TEAM_PLAN_ID=plan_team_id
RAZORPAY_CURRENCY=INR
RAZORPAY_PRO_AMOUNT=166700
RAZORPAY_TEAM_AMOUNT=828200

# URLs
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com

# CORS (comma-separated)
CORS_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com

# Rate Limits (queries per day)
RATE_LIMIT_FREE=50
RATE_LIMIT_PRO=1000
RATE_LIMIT_TEAM=5000
