{
  "name": "contextos-copilot",
  "displayName": "ContextOS",
  "description": "The AI Copilot that knows everything about your workspace.",
  "version": "2.2.0",
  "publisher": "JeyaSuryaM",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeyasurya14/ContextOS.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "AI",
    "copilot",
    "context",
    "github",
    "notion",
    "slack",
    "assistant",
    "chat",
    "gpt",
    "rag"
  ],
  "license": "MIT",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextos.setApiKey",
        "title": "ContextOS: Set API Key",
        "category": "ContextOS",
        "icon": "$(key)"
      },
      {
        "command": "contextos.ask",
        "title": "ContextOS: Send Code to Chat",
        "category": "ContextOS",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "contextos.explainFile",
        "title": "ContextOS: Explain Current File",
        "category": "ContextOS",
        "icon": "$(book)"
      },
      {
        "command": "contextos.findBugs",
        "title": "ContextOS: Find Bugs in Code",
        "category": "ContextOS",
        "icon": "$(bug)"
      },
      {
        "command": "contextos.clearCache",
        "title": "ContextOS: Clear Cache",
        "category": "ContextOS",
        "icon": "$(trash)"
      },
      {
        "command": "contextos.showStats",
        "title": "ContextOS: Show Stats",
        "category": "ContextOS",
        "icon": "$(pulse)"
      },
      {
        "command": "contextos.openSettings",
        "title": "ContextOS: Open Settings",
        "category": "ContextOS",
        "icon": "$(gear)"
      },
      {
        "command": "contextos.actions",
        "title": "ContextOS: Run Integration Action",
        "category": "ContextOS",
        "icon": "$(rocket)"
      },
      {
        "command": "contextos.github.createIssue",
        "title": "ContextOS: GitHub — Create Issue",
        "category": "ContextOS",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "contextos.github.createPR",
        "title": "ContextOS: GitHub — Create Pull Request",
        "category": "ContextOS",
        "icon": "$(git-merge)"
      },
      {
        "command": "contextos.linear.createIssue",
        "title": "ContextOS: Linear — Create Issue",
        "category": "ContextOS",
        "icon": "$(checklist)"
      },
      {
        "command": "contextos.notion.createPage",
        "title": "ContextOS: Notion — Create Page",
        "category": "ContextOS",
        "icon": "$(notebook)"
      },
      {
        "command": "contextos.slack.sendMessage",
        "title": "ContextOS: Slack — Send Message",
        "category": "ContextOS",
        "icon": "$(comment)"
      },
      {
        "command": "contextos.git.commitPushPR",
        "title": "ContextOS: Git — Commit, Push & Open PR",
        "category": "ContextOS",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "group": "contextos@1",
          "when": "editorHasSelection",
          "command": "contextos.ask"
        },
        {
          "group": "contextos@2",
          "when": "editorHasSelection",
          "command": "contextos.findBugs"
        },
        {
          "group": "contextos@3",
          "when": "!editorHasSelection",
          "command": "contextos.explainFile"
        }
      ],
      "view/title": [
        {
          "command": "contextos.clearCache",
          "when": "view == contextos.chatView",
          "group": "navigation@1"
        },
        {
          "command": "contextos.openSettings",
          "when": "view == contextos.chatView",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextos-explorer",
          "title": "ContextOS",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "contextos-explorer": [
        {
          "type": "webview",
          "id": "contextos.chatView",
          "name": "Assistant",
          "icon": "images/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "ContextOS",
      "properties": {
        "contextos.apiUrl": {
          "type": "string",
          "default": "https://contextos-api-jxdr.onrender.com",
          "description": "The ContextOS API base URL. Defaults to the cloud API. Change to http://localhost:8000 for local development."
        },
        "contextos.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum number of retry attempts for failed requests."
        },
        "contextos.timeout": {
          "type": "number",
          "default": 120000,
          "minimum": 10000,
          "maximum": 300000,
          "description": "Request timeout in milliseconds (default: 120000 = 2 minutes)."
        },
        "contextos.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry to help improve the extension. No personal data is collected."
        },
        "contextos.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode for detailed logging in the Developer Tools console."
        },
        "contextos.rateLimitMaxRequests": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum requests allowed per rate-limit window."
        },
        "contextos.rateLimitWindowMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Rate limit time window in milliseconds (default: 60000 = 1 minute)."
        },
        "contextos.cacheTTL": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "maximum": 3600000,
          "description": "Cache time-to-live in milliseconds (default: 300000 = 5 minutes). Set to 0 to disable caching."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "package:dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild-watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vsce": "^2.15.0"
  }
}
