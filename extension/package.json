{
  "name": "contextos-copilot",
  "displayName": "ContextOS",
  "description": "The AI Copilot that knows everything about your workspace.",
  "version": "1.3.7",
  "publisher": "JeyaSuryaM",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeyasurya14/ContextOS.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "AI",
    "copilot",
    "context",
    "github",
    "notion",
    "slack",
    "assistant",
    "chat",
    "gpt",
    "rag"
  ],
  "license": "MIT",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contextos.setApiKey",
        "title": "ContextOS: Set API Key"
      },
      {
        "command": "contextos.ask",
        "title": "ContextOS: Send Code to Chat"
      },
      {
        "command": "contextos.explainFile",
        "title": "ContextOS: Explain Current File"
      },
      {
        "command": "contextos.findBugs",
        "title": "ContextOS: Find Bugs in Code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextos-explorer",
          "title": "ContextOS",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "contextos-explorer": [
        {
          "type": "webview",
          "id": "contextos.chatView",
          "name": "Assistant",
          "icon": "images/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "ContextOS",
      "properties": {
        "contextos.apiUrl": {
          "type": "string",
          "default": "https://contextos-api-jxdr.onrender.com",
          "description": "The ContextOS API base URL. Defaults to the cloud API. Change to http://localhost:8000 for local development."
        },
        "contextos.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum number of retry attempts for failed requests."
        },
        "contextos.timeout": {
          "type": "number",
          "default": 120000,
          "minimum": 10000,
          "maximum": 300000,
          "description": "Request timeout in milliseconds (default: 120000 = 2 minutes)."
        },
        "contextos.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry to help improve the extension. No personal data is collected."
        },
        "contextos.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode for detailed logging."
        },
        "contextos.rateLimitMaxRequests": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum requests allowed per time window."
        },
        "contextos.rateLimitWindowMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Rate limit time window in milliseconds (default: 60000 = 1 minute)."
        },
        "contextos.cacheTTL": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "maximum": 3600000,
          "description": "Cache time-to-live in milliseconds (default: 300000 = 5 minutes)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild-watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vsce": "^2.15.0"
  }
}
